# ---- copy to .env and edit ----
NODE_ENV=development
PORT=3000

POSTGRES_USER=servicebay
POSTGRES_PASSWORD=servicebay
POSTGRES_DB=servicebay_db

# generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_64_hex_chars_________________________________________
JWT_REFRESH_SECRET=replace_with_64_hex_chars_________________________________________
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGIN=http://localhost:8080

# first manager account created by `prisma db seed`
SEED_MANAGER_EMAIL=manager@servicebay.local
SEED_MANAGER_PASSWORD=ChangeMe123!
SEED_MANAGER_NAME=Manager

# production only (Traefik labels)
DOMAIN=servicebay.sightser.site

# ---- email (password reset) ----
# public base URL used in emailed links
APP_URL=http://localhost:8080
# Resend API key. Leave EMPTY locally: emails are then printed to `docker compose logs backend` instead of sent.
RESEND_API_KEY=
# must be on a domain verified in Resend (SPF + DKIM). onboarding@resend.dev works for testing to your own address only.
MAIL_FROM=ServiceBay <no-reply@sightser.site>
