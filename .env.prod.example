# ---- production: copy to .env.prod on the server, never commit ----
NODE_ENV=production
PORT=3000

POSTGRES_USER=servicebay
POSTGRES_PASSWORD=CHANGE_ME_long_random
POSTGRES_DB=servicebay_db

# openssl rand -hex 32  (each, different)
JWT_ACCESS_SECRET=CHANGE_ME_64_hex
JWT_REFRESH_SECRET=CHANGE_ME_64_hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# same origin as the app, so CORS effectively only matters for tooling
CORS_ORIGIN=https://servicebay.sightser.site
DOMAIN=servicebay.sightser.site

SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=CHANGE_ME_strong
SEED_MANAGER_NAME=Manager

# ---- email (password reset) ----
# public base URL used in emailed links
APP_URL=https://servicebay.sightser.site
# Resend API key. Leave EMPTY locally: emails are then printed to `docker compose logs backend` instead of sent.
RESEND_API_KEY=
# must be on a domain verified in Resend (SPF + DKIM). onboarding@resend.dev works for testing to your own address only.
MAIL_FROM=ServiceBay <no-reply@sightser.site>
