# ---- Google Cloud deploy config: copy to .env.gcp (git-ignored). Read by infra/gcp/deploy-gcp.sh ----
PROJECT_ID=your-gcp-project-id
REGION=europe-west1                 # Belgium. (europe-north1 Finland also fine for Cloud Run; keep Hosting rewrite region in sync)
SERVICE=servicebay-api
DOMAIN=servicebay.sightser.site
GCS_BUCKET=your-project-id-servicebay-uploads      # bucket names are global; must be unique
BACKUP_BUCKET=your-project-id-servicebay-backups

# ---- secrets: pushed to Secret Manager by the deploy script, never passed on the command line ----
# Neon: use the DIRECT (non-pooled) connection string, e.g. postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
JWT_ACCESS_SECRET=            # openssl rand -hex 32
JWT_REFRESH_SECRET=           # openssl rand -hex 32 (different)
RESEND_API_KEY=
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=        # strong; the client changes it on first login
SEED_MANAGER_NAME=Manager
MAIL_FROM=ServiceBay <no-reply@sightser.site>
